{
  "name": "shopware/k8s-meta",
  "type": "symfony-bundle",
  "license": "MIT",
  "description": "Symfony bundle that configures Shopware for the Shopware Operator",
  "require": {
    "php": ">=8.2",
    "composer-runtime-api": "^2.0",
    "shopware/core": "~6.6.0 || ~6.7.0",
    "open-telemetry/exporter-otlp": "^1.1",
    "open-telemetry/transport-grpc": "^1.1",
    "shopware/opentelemetry": "^0.1.5",
    "shopware/deployment-helper": "*",
    "league/flysystem-async-aws-s3": "*",
    "symfony/redis-messenger": "^7 || ^6",
    "symfony/amazon-sqs-messenger": "^7 || ^6",
    "symfony/dependency-injection": "^7 || ^6.4",
    "symfony/http-kernel": "^7 || ^6.4",
    "symfony/messenger": "^7 || ^6.4",
    "composer/semver": "^3.0",
    "symfony/cache": "^7 || ^6.4",
    "symfony/http-foundation": "^7 || ^6.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "symfony/framework-bundle": "^7 || ^6.4",
    "symfony/mailer": "^7 || ^6.4"
  },
  "autoload": {
    "psr-4": {
      "Shopware\\K8sMeta\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shopware\\K8sMeta\\Tests\\": "tests/"
    }
  }
}
